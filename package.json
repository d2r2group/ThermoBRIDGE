{
  "name": "thermobridge",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Interactive T-X phase diagram of a binary regular-solution system with linked Gibbs energy curves and common tangents, for teaching MATL7355.",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "math": "node scripts/renderMath.mjs",
    "mockup": "node scripts/renderMockup.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run --reporter=verbose",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/lato": "^5.3.0",
    "d3": "^7.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/d3": "^7.4.3",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.18.0",
    "globals": "^17.13.0",
    "mathjax-full": "^3.2.2",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
